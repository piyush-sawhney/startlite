# Copy this file to .env.local and fill every empty secret.
# Never commit .env.local.

DATABASE_URL=postgres://postgres:startlite@localhost:5433/startlite

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Salt for hashing buyer IP addresses. Use a second random value.
IP_HASH_SECRET=

# Local demo account created by db:seed. Use any password of 8+ characters.
SEED_EMAIL=anita@example.com
SEED_PASSWORD=
SEED_NAME=Anita Sharma

# Optional. Password for the 24 accounts created by db:seed:dev.
# Defaults to StartLite!Dev2026 when empty. Development only.
DEV_SEED_PASSWORD=

MEDIA_ROOT=./.data/media

# Optional. Leave empty to skip the bot check in local development.
TURNSTILE_SECRET_KEY=
